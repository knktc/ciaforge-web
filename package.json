{
  "name": "ciaforge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run check:pages",
    "check:pages": "node scripts/check-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx scripts/test-file-drop.mts"
  },
  "dependencies": {
    "hash.js": "1.1.7"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
